# Copy to deploy/.env and replace every value. Nothing here is a secret for a
# shared or remote system: the stack binds 127.0.0.1 only.
#
# This file is named env.example, not .env.example, because the repository
# governance check forbids tracking any path whose segment starts with ".env".

# Local Fuseki admin password. Any value works; it protects a loopback dataset.
# `doctor` also needs it to verify the Fuseki version, because /$/server is
# authenticated on the pinned image.
MFG_FUSEKI_ADMIN_PASSWORD=placeholder-change-me

# Published loopback ports. Compose publishes these, and
# `mfg-agentgraph-stack` derives its endpoints from them, so one number keeps
# both sides in step. Set MFG_FUSEKI_URL / MFG_QDRANT_URL / MFG_OLLAMA_URL only
# to point the CLI somewhere else; an explicit URL always wins.
MFG_FUSEKI_PORT=3030
MFG_QDRANT_PORT=6333
MFG_OLLAMA_PORT=11434

# A cold bootstrap downloads the pinned models (several GB). Raise this if the
# one-hour default is not enough for the connection.
# MFG_OLLAMA_PULL_TIMEOUT_SECONDS=3600

# The pinned Fuseki image publishes its query service as "sparql", so the
# endpoint is /ds/sparql. Change only with an image whose assembler differs.
MFG_FUSEKI_QUERY_SERVICE=sparql

# TDB2 configuration lives in deploy/fuseki/ and is mounted by compose.
# SHACL is validated in-process by pyshacl, so the Fuseki SHACL endpoint stays off.
MFG_FUSEKI_ENABLE_SHACL=false
MFG_OLLAMA_KEEP_ALIVE=5m
